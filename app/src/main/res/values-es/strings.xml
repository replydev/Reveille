    <string name="health_check_miui_autostart_title">Inicio automático activado</string>
    <string name="health_check_miui_autostart_detail">Sin el inicio automático, HyperOS no avisa a Reveille de que el teléfono se ha reiniciado, así que las alarmas se pierden tras un reinicio.</string>
